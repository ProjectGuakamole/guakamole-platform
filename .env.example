# Plantilla de variables de entorno para desarrollo local.
#
# Uso recomendado:
#   cp .env.example .env
#   docker compose up --build
#
# IMPORTANTE:
# - Este archivo es una plantilla versionada.
# - El archivo `.env` local no se versiona y debe crearse a partir de esta plantilla.
# - Si esta plantilla cambia, cada desarrollador debe actualizar su `.env` local.
# - No debe contener secretos reales.
# - Sustituye todos los valores `change-me-*` en tu `.env` local.
# - No uses `.env.example` como configuración real de producción o staging.

# Base de datos PostgreSQL
# Dentro de Docker Compose, el host debe ser el nombre del servicio: `postgres`.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=guakamole_db
POSTGRES_USER=guakamole_user
POSTGRES_PASSWORD=change-me-postgres-password

# Backend
# Dentro de Docker Compose, el host debe ser el nombre del servicio: `backend`.
BACKEND_HOST=backend
BACKEND_PORT=8000

# Frontend
# Dentro de Docker Compose, el host debe ser el nombre del servicio: `frontend`.
FRONTEND_HOST=frontend
FRONTEND_PORT=3000

# Nginx
# Dentro de Docker Compose, el host debe ser el nombre del servicio: `nginx`.
NGINX_HOST=nginx
NGINX_PORT=80

# Redis
# Dentro de Docker Compose, el host debe ser el nombre del servicio: `redis`.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Seguridad / JWT
JWT_SECRET=change-me-generate-a-secure-random-secret
JWT_ALGORITHM=HS256
