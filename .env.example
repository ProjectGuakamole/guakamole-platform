# Plantilla no operativa. Cópiala a .env y sustituye todos los valores.
# La aplicación nunca carga este archivo: Make y Compose usan ENV_FILE=.env.
APP_ENV=development
POSTGRES_USER=<usuario-postgres>
POSTGRES_PASSWORD=<contrasena-postgres>
POSTGRES_DB=<base_datos>
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@<host>:<puerto>/<base_datos>
TEST_DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@<host>:<puerto>/<base_datos>_test
# Destinos dedicados locales; DATABASE_URL no se usa para bootstrap, demo ni rebaseline.
BOOTSTRAP_DEVELOPMENT_DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@localhost:<puerto>/<base_datos>_dev
DEMO_DEVELOPMENT_DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@localhost:<puerto>/<base_datos>_dev
REBASELINE_DEVELOPMENT_DATABASE_URL=postgresql+psycopg://<usuario>:<contrasena>@localhost:<puerto>/<base_datos>_dev
DEMO_SEED_PASSWORD=<contrasena-demo-no-versionada>
JWT_SECRET_KEY=<secreto-aleatorio-de-al-menos-32-caracteres>
JWT_ALGORITHM=HS256
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ENABLE_PASSWORD_BEARER_TOKEN=false
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_AUTHORIZATION_HEADER=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
